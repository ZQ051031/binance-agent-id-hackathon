# Which chain the UI talks to: 31337 (local Hardhat), 97 (BSC testnet) or 56 (BSC mainnet)
NEXT_PUBLIC_CHAIN_ID=31337
# AgentTaskBoard address (fill in after you deploy; scripts/local-setup.ts writes .env.local for you)
NEXT_PUBLIC_TASKBOARD_ADDRESS=0x0000000000000000000000000000000000000000
# Agent ID contract. BSC mainnet: 0x60b9262456de011f7d15a54cdd8c48baaa8b022f
NEXT_PUBLIC_AGENT_ID_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f
# Optional RPC overrides
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=
# Shows a "mint test Agent ID" button. Only honoured on chain 31337/97 with a MockAgentID.
NEXT_PUBLIC_ENABLE_TEST_MINT=false
