# Copy to .env and fill in. NEVER commit .env. The deployer key is only used locally by Hardhat
# to sign YOUR deployment; this project never asks for, stores or transmits keys or seed phrases.
DEPLOYER_PRIVATE_KEY=
# Optional custom RPCs (defaults are the public BNB Chain endpoints)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Etherscan API v2 key (free at etherscan.io; works for BscScan chain 56 and 97)
ETHERSCAN_API_KEY=
# Agent ID contract (default on BSC mainnet)
AGENT_ID_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f
# Optional: board owner (default: deployer). Owner can only pause new activity.
OWNER_ADDRESS=
# Testnet only: deploy a test-only MockAgentID instead of using AGENT_ID_ADDRESS
DEPLOY_MOCK_AGENT_ID=false
# Must be "yes" to deploy on BSC mainnet
CONFIRM_MAINNET=
